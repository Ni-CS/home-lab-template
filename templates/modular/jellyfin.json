{
  "cpu": {
    "image": "jellyfin/jellyfin:latest",
    "restart": "no",
    "logging": {
      "driver": "local",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "volumes": [
      "@STATE@/jellyfin/config:/config",
      "@STATE@/jellyfin/cache:/cache",
      "@DATA@/media:/media:ro"
    ],
    "ports": [
      {
        "target": 8096,
        "published": "8096",
        "host_ip": "@BIND@",
        "protocol": "tcp"
      }
    ]
  },
  "gpu": {
    "image": "jellyfin/jellyfin:latest",
    "restart": "no",
    "logging": {
      "driver": "local",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "volumes": [
      "@STATE@/jellyfin/config:/config",
      "@STATE@/jellyfin/cache:/cache",
      "@DATA@/media:/media:ro"
    ],
    "ports": [
      {
        "target": 8096,
        "published": "8096",
        "host_ip": "@BIND@",
        "protocol": "tcp"
      }
    ],
    "deploy": {
      "resources": {
        "reservations": {
          "devices": [
            {
              "driver": "nvidia",
              "count": 1,
              "capabilities": [
                "gpu"
              ]
            }
          ]
        }
      }
    },
    "environment": {
      "NVIDIA_VISIBLE_DEVICES": "all",
      "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,video"
    }
  }
}
