{
  "cpu": {
    "image": "ghcr.io/open-webui/open-webui:main",
    "restart": "no",
    "logging": {
      "driver": "local",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "volumes": [
      "@STATE@/open-webui:/app/backend/data"
    ],
    "ports": [
      {
        "target": 8080,
        "published": "3000",
        "host_ip": "@BIND@",
        "protocol": "tcp"
      }
    ],
    "environment": {
      "OLLAMA_BASE_URL": "http://ollama:11434",
      "WEBUI_SECRET_KEY": "${WEBUI_SECRET_KEY:?set WEBUI_SECRET_KEY explicitly}"
    },
    "depends_on": {
      "ollama": {
        "condition": "service_started"
      }
    }
  },
  "gpu": null
}
