{
  "cpu": {
    "image": "lscr.io/linuxserver/qbittorrent:latest",
    "restart": "no",
    "logging": {
      "driver": "local",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "volumes": [
      "@STATE@/qbittorrent:/config",
      "@DATA@/media:/media"
    ],
    "ports": [
      {
        "target": 8080,
        "published": "8080",
        "host_ip": "@BIND@",
        "protocol": "tcp"
      },
      {
        "target": 6881,
        "published": "6881",
        "host_ip": "@BIND@",
        "protocol": "tcp"
      },
      {
        "target": 6881,
        "published": "6881",
        "host_ip": "@BIND@",
        "protocol": "udp"
      }
    ],
    "environment": {
      "PUID": "${PUID:-1000}",
      "PGID": "${PGID:-1000}",
      "WEBUI_PORT": "8080"
    }
  },
  "gpu": null
}
